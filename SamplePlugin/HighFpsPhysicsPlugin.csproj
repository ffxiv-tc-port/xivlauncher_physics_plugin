<Project Sdk="Dalamud.NET.Sdk/13.0.0">

  <PropertyGroup>
    <Authors>ItsLunaYup</Authors>
    <Version>8.3.0.1</Version>
    <Description>降低物理效果的更新頻率，讓物理效果在高 FPS 下較正常地運作。</Description>
    <PackageProjectUrl>https://github.com/cycleapple/xivlauncher_physics_plugin</PackageProjectUrl>

    <TargetFramework>net9.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Plugin manifest -->
  <ItemGroup>
    <Content Include="..\SamplePlugin\HighFpsPhysicsPlugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
